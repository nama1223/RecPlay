/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "recplay",
	"main": "src/index.js",
	"compatibility_date": "2026-04-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"R2_ACCOUNT_ID": "4600f3a7aa72ec4fa62b3a9a24afb2b8",
		"R2_BUCKET_NAME": "recplay-audio"
	},
	"r2_buckets": [
		{
			"bucket_name": "recplay-audio",
			"binding": "recplay_audio",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "RECPLAY_KV",
			"id": "5410a23ebfdc46488258f6decb119b24",
			"remote": true
		}
	]
	/**
	 * Required secrets (set via: wrangler secret put SECRET_NAME)
	 *   R2_ACCESS_KEY_ID     - R2 API token access key
	 *   R2_SECRET_ACCESS_KEY - R2 API token secret key
	 *   ADMIN_PASSWORD       - password for admin panel
	 */
}
